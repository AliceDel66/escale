    "Le fichier %@ est illisible ; il sera mis de côté au prochain enregistrement." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file %@ is unreadable; it will be set aside on the next save."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件 %@ 无法读取；下次保存时将被备份隔离。"
          }
        }
      }
    },
    "Le fichier distant a été modifié depuis son téléchargement. Écraser la version distante par votre version locale ?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The remote file was modified after you downloaded it. Overwrite the remote version with your local one?"
          }
